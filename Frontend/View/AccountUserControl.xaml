<UserControl x:Class="Frontend.View.AccountUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Frontend.View"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1200"
             Background="#EEF3FB"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <local:UrlToImageConverter x:Key="UrlToImage"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ===== Khung ===== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270"
                                      Opacity="0.08" Color="#082B63"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Đường kẻ chia mục -->
        <Style x:Key="Divider" TargetType="Rectangle">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Fill" Value="{StaticResource LineColor}"/>
        </Style>

        <!-- ===== Chữ ===== -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryDark}"/>
        </Style>

        <Style x:Key="SectionDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="Margin" Value="0,4,24,0"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryDark}"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="2,-6,0,0"/>
        </Style>

        <!-- Dòng báo lỗi: tự ẩn khi không có nội dung -->
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D32F2F"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="2,-6,0,6"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ===== Ô nhập (dùng chung cho TextBox và PasswordBox) ===== -->
        <Style x:Key="FieldInput" TargetType="Control">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,5,0,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryDark}"/>
            <Setter Property="Background" Value="{StaticResource SoftBg}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="10,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#B9C8E0"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryMid}"/>
                                <Setter TargetName="bd" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ô chỉ đọc (tên đăng nhập) -->
        <Style x:Key="ReadOnlyInput" TargetType="TextBox" BasedOn="{StaticResource FieldInput}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="#E9EEF6"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>

        <!-- ===== Nút ===== -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GeneralButton}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Padding" Value="20,0"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryMid}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineColor}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SoftBg}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryMid}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
            <Setter Property="Foreground" Value="#D32F2F"/>
            <Setter Property="BorderBrush" Value="#F3C5C5"/>
        </Style>
        <!-- Ô icon tròn góc của từng mục -->
        <Style x:Key="IconBadge" TargetType="Border">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="IconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Thanh tiến độ điểm 0 – 9 -->
        <Style x:Key="ScoreBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="5" Background="#EEF3FB"/>
                            <Border x:Name="PART_Indicator" CornerRadius="5" HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FFC857" Offset="0"/>
                                        <GradientStop Color="#F5A623" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Vạch mục tiêu: ProgressBar trong suốt, chỉ vẽ một vạch ở vị trí Value -->
        <Style x:Key="TargetMarker" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="Transparent"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="Transparent"
                                    BorderBrush="{StaticResource PrimaryDark}" BorderThickness="0,0,3,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== TIÊU ĐỀ ===== -->
        <StackPanel Grid.Row="0" Margin="2,0,0,16">
            <TextBlock Text="Thông tin tài khoản" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryDark}"/>
            <TextBlock Text="Quản lý hồ sơ, thông tin liên hệ và bảo mật tài khoản của bạn" FontSize="13.5"
                       Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- ===== THÔNG BÁO LỖI KHI TẢI ===== -->
        <Border Grid.Row="1" Background="#FDECEC" BorderBrush="#F3C5C5" BorderThickness="1"
                CornerRadius="12" Padding="16,10" Margin="0,0,0,16">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LoadError}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE783;" Foreground="#D32F2F"
                           FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" Text="{Binding LoadError}" Foreground="#B71C1C" FontSize="13.5"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="Thử lại" Style="{StaticResource OutlineButton}"
                        Height="32" Margin="12,0,0,0" Command="{Binding ReloadCommand}"/>
            </Grid>
        </Border>

        <!-- ===== ĐANG TẢI ===== -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE895;" FontSize="32"
                       Foreground="{StaticResource PrimaryMid}" HorizontalAlignment="Center"/>
            <TextBlock Text="Đang tải thông tin tài khoản..." FontSize="15" Margin="0,12,0,0"
                       Foreground="{StaticResource TextMuted}"/>
        </StackPanel>

        <!-- ===== NỘI DUNG ===== -->
        <Grid Grid.Row="2" Visibility="{Binding HasProfile, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ========== CỘT TRÁI: HỒ SƠ ========== -->
            <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,24,22,22">
                        <Grid Width="104" Height="104" HorizontalAlignment="Center">
                            <Ellipse Fill="{StaticResource AccentGold}"/>
                            <TextBlock Text="{Binding UserInitial}" FontSize="42" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryDark}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <!-- Ảnh đè lên chữ cái đầu; đường dẫn sai thì ảnh trống, chữ vẫn hiện -->
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush Stretch="UniformToFill"
                                                ImageSource="{Binding AvatarUrl, Converter={StaticResource UrlToImage}}"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Stroke="White" StrokeThickness="4"/>
                        </Grid>

                        <TextBlock Text="{Binding Username}" FontSize="19" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryDark}" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="0,12,0,0"/>
                        <TextBlock Text="Học viên EngLearn" FontSize="12.5" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>

                        <!-- Điểm hiện tại | Điểm mục tiêu -->
                        <Border Background="{StaticResource SoftBg}" CornerRadius="12" Padding="4,12" Margin="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Hiện tại" FontSize="12" Foreground="{StaticResource TextMuted}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding AchievedText}" FontSize="22" FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryMid}" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Rectangle Grid.Column="1" Fill="{StaticResource LineColor}"/>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="Mục tiêu" FontSize="12" Foreground="{StaticResource TextMuted}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding TargetScoreDisplay}" FontSize="22" FontWeight="Bold"
                                               Foreground="#C68A00" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Text="Thang điểm 0.0 – 9.0" FontSize="11" Foreground="{StaticResource TextMuted}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>

                        <Rectangle Style="{StaticResource Divider}" Margin="0,18"/>

                        <!-- Ảnh đại diện: nhập ngay dưới ảnh xem trước -->
                        <TextBlock Text="Ảnh đại diện" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding AvatarUrl, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                                 Style="{StaticResource FieldInput}" MaxLength="255"
                                 ToolTip="Dán đường dẫn ảnh bắt đầu bằng https://"/>
                        <TextBlock Text="{Binding AvatarUrlError}" Style="{StaticResource ErrorText}"/>
                        <TextBlock Text="Dán đường dẫn ảnh (https://...), ảnh sẽ hiện ngay ở trên."
                                   Style="{StaticResource HintText}"/>

                        <Rectangle Style="{StaticResource Divider}" Margin="0,18"/>

                        <Button Style="{StaticResource OutlineButton}" Command="{Binding ReloadCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" Margin="0,2,8,0"/>
                                <TextBlock Text="Tải lại thông tin"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DangerButton}" Command="{Binding LogoutCommand}" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xF3B1;" Margin="0,2,8,0"/>
                                <TextBlock Text="Đăng xuất"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ========== CỘT PHẢI: CÁC MỤC CHỈNH SỬA + THANH LƯU ========== -->
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,24,28,8">

                            <!-- Liên hệ -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBadge}" Background="#E6EEFB">
                                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE715;" Foreground="{StaticResource PrimaryMid}"/>
                                </Border>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Liên hệ" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Dùng để liên lạc và khôi phục tài khoản khi cần." Style="{StaticResource SectionDesc}"
                                               Margin="0,2,0,14"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource FieldInput}"/>
                                            <TextBlock Text="{Binding EmailError}" Style="{StaticResource ErrorText}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Số điện thoại" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource FieldInput}" MaxLength="15"/>
                                            <TextBlock Text="{Binding PhoneNumberError}" Style="{StaticResource ErrorText}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Rectangle Style="{StaticResource Divider}" Margin="56,12,0,20"/>

                            <!-- Học tập -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBadge}" Background="#FFF4DC">
                                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE7BE;" Foreground="#C68A00"/>
                                </Border>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Mục tiêu học tập" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Đặt điểm bạn muốn đạt, tiến độ được tính từ kết quả các bộ đề bạn đã làm."
                                               Style="{StaticResource SectionDesc}" Margin="0,2,0,14"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Điểm mục tiêu (0 – 9)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding TargetScoreText, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource FieldInput}" MaxLength="5"/>
                                            <TextBlock Text="{Binding TargetScoreError}" Style="{StaticResource ErrorText}"/>
                                        </StackPanel>

                                        <!-- Thanh so sánh: phần tô = điểm hiện tại, vạch đậm = mục tiêu -->
                                        <StackPanel Grid.Column="2" Margin="0,0,0,8" VerticalAlignment="Bottom">
                                            <Grid Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Fill="#F5A623" Margin="0,0,6,0"/>
                                                    <TextBlock FontSize="12.5" Foreground="{StaticResource TextMuted}">
                                                        <Run Text="Hiện tại"/>
                                                        <Run Text="{Binding AchievedText, Mode=OneWay}" FontWeight="Bold"
                                                             Foreground="{StaticResource PrimaryDark}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Rectangle Width="3" Height="12" Fill="{StaticResource PrimaryDark}" Margin="0,0,6,0"/>
                                                    <TextBlock FontSize="12.5" Foreground="{StaticResource TextMuted}">
                                                        <Run Text="Mục tiêu"/>
                                                        <Run Text="{Binding TargetText, Mode=OneWay}" FontWeight="Bold"
                                                             Foreground="{StaticResource PrimaryDark}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Height="20">
                                                <ProgressBar Style="{StaticResource ScoreBar}" Maximum="9"
                                                             Value="{Binding AchievedValue, Mode=OneWay}"/>
                                                <ProgressBar Style="{StaticResource TargetMarker}" Maximum="9"
                                                             Value="{Binding TargetValue, Mode=OneWay}"
                                                             Visibility="{Binding HasTargetPreview, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>

                                            <Grid Margin="0,4,0,0">
                                                <TextBlock Text="0" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                                <TextBlock Text="5" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="10" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right"/>
                                            </Grid>

                                            <!-- Lời nhắn tiến độ -->
                                            <Border CornerRadius="8" Padding="10,6" Margin="0,8,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource SoftBg}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsTargetReached}" Value="True">
                                                                <Setter Property="Background" Value="#E7F6EE"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding ProgressMessage}" FontSize="12"
                                                           Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Rectangle Style="{StaticResource Divider}" Margin="56,12,0,20"/>

                            <!-- Bảo mật -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconBadge}" Background="#E7F6EE">
                                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE72E;" Foreground="#2E8B57"/>
                                </Border>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Bảo mật" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Nhập mật khẩu hiện tại để xác nhận. Để trống nếu bạn không muốn đổi mật khẩu." Style="{StaticResource SectionDesc}"
                                               Margin="0,2,0,14"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Mật khẩu hiện tại" Style="{StaticResource FieldLabel}"/>
                                            <PasswordBox x:Name="pwbCurrentPassword" Style="{StaticResource FieldInput}"
                                                         PasswordChanged="pwbCurrentPassword_PasswordChanged"/>
                                            <TextBlock Text="{Binding CurrentPasswordError}" Style="{StaticResource ErrorText}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Mật khẩu mới" Style="{StaticResource FieldLabel}"/>
                                            <PasswordBox x:Name="pwbNewPassword" Style="{StaticResource FieldInput}"
                                                         PasswordChanged="pwbNewPassword_PasswordChanged"/>
                                            <TextBlock Text="{Binding NewPasswordError}" Style="{StaticResource ErrorText}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Nhập lại mật khẩu mới" Style="{StaticResource FieldLabel}"/>
                                            <PasswordBox x:Name="pwbConfirmPassword" Style="{StaticResource FieldInput}"
                                                         PasswordChanged="pwbConfirmPassword_PasswordChanged"/>
                                            <TextBlock Text="{Binding ConfirmPasswordError}" Style="{StaticResource ErrorText}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Quy tắc mật khẩu -->
                                    <Border Background="{StaticResource SoftBg}" CornerRadius="8" Padding="12,8" Margin="0,2,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" FontSize="13"
                                                       Foreground="{StaticResource TextMuted}" Margin="0,1,8,0"/>
                                            <TextBlock FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                                                       Text="6–50 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt (! @ # $ % / | &amp;)."/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Thanh lưu: chân của khung -->
                    <Border Grid.Row="1" BorderBrush="{StaticResource LineColor}" BorderThickness="0,1,0,0"
                            Background="#FAFCFF" CornerRadius="0,0,16,16" Padding="28,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#4CAF50"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasChanges}" Value="True">
                                                    <Setter Property="Fill" Value="#F5A623"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Mọi thay đổi đã được lưu"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasChanges}" Value="True">
                                                    <Setter Property="Text" Value="Bạn có thay đổi chưa lưu"/>
                                                    <Setter Property="Foreground" Value="#B7791F"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <Button Grid.Column="1" Content="Hoàn tác" Style="{StaticResource OutlineButton}"
                                    Command="{Binding ResetCommand}" Margin="0,0,10,0"/>

                            <Button Grid.Column="2" Command="{Binding SaveCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Content" Value="Lưu thay đổi"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Content" Value="Đang lưu..."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
