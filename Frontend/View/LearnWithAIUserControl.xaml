<UserControl x:Class="Frontend.View.LearnWithAIUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Frontend.ViewModel.LearnWithAI"
             mc:Ignorable="d"
             d:DesignHeight="680" d:DesignWidth="1200"
             Background="#EEF3FB"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- ===== Nhãn của từng mục cấu hình ===== -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- ===== Nút chọn kỹ năng ở cột trái ===== -->
        <Style x:Key="SkillNavButton" TargetType="RadioButton">
            <Setter Property="GroupName" Value="SkillNav"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="12"
                                Padding="12,10" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SoftBg}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E6EEFB"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#C9D8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Chip chọn (dùng cho tình huống, hình thức, độ khó) ===== -->
        <Style x:Key="ChipItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource PrimaryDark}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="White" CornerRadius="18" Padding="14,8"
                                BorderBrush="{StaticResource LineColor}" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryMid}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryDark}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryDark}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipList" TargetType="ListBox">
            <Setter Property="ItemContainerStyle" Value="{StaticResource ChipItem}"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <!-- Bỏ ScrollViewer riêng của ListBox để cuộn chuột hoạt động với trang -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Ô nhập liệu bo góc ===== -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryDark}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="White" CornerRadius="10"
                                BorderBrush="{StaticResource LineColor}" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="12,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryMid}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chữ gợi ý mờ: hiện khi ô nhập trống -->
        <Style x:Key="Placeholder" TargetType="TextBlock">
            <Setter Property="Margin" Value="14,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#9AA8C2"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <!-- ===== Nút chính ===== -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="28,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource PrimaryDark}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryMid}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Thẻ chủ đề ngữ pháp ===== -->
        <Style x:Key="TopicCard" TargetType="Button">
            <Setter Property="Width" Value="232"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource SoftBg}" CornerRadius="14"
                                Padding="16" BorderBrush="#E3EAF6" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="White"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryMid}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Thanh tiến độ mảnh ===== -->
        <Style x:Key="ThinProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="3" Background="#E3EAF6"/>
                            <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#0B3A82" Offset="0"/>
                                        <GradientStop Color="#1E88E5" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =====================================================
             GIAO DIỆN LISTENING / READING
             ===================================================== -->
        <DataTemplate DataType="{x:Type vm:SkillPracticeViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Tiêu đề -->
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Border Width="52" Height="52" CornerRadius="14" Background="#E6EEFB">
                        <TextBlock Text="{Binding Icon}" FontSize="24"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryDark}"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="13"
                                   Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Các lựa chọn -->
                <ScrollViewer Grid.Row="1" Margin="0,24,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Chọn tình huống" Style="{StaticResource FieldLabel}"/>
                        <ListBox Style="{StaticResource ChipList}"
                                 ItemsSource="{Binding Situations}"
                                 SelectedItem="{Binding SelectedSituation, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Name}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="Hoặc tự nhập chủ đề bạn muốn" Margin="0,10,0,10"
                                   Style="{StaticResource FieldLabel}"/>
                        <Grid MaxWidth="440" HorizontalAlignment="Left" Width="440">
                            <TextBox x:Name="customTopicBox" Style="{StaticResource InputBox}"
                                     Text="{Binding CustomTopic, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Ví dụ: đi xem bóng đá, mua điện thoại mới...">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Placeholder}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=customTopicBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <TextBlock Text="Hình thức" Margin="0,24,0,10" Style="{StaticResource FieldLabel}"/>
                        <ListBox Style="{StaticResource ChipList}"
                                 ItemsSource="{Binding Formats}"
                                 SelectedItem="{Binding SelectedFormat, Mode=TwoWay}"/>

                        <TextBlock Text="Độ khó" Margin="0,14,0,10" Style="{StaticResource FieldLabel}"/>
                        <ListBox Style="{StaticResource ChipList}"
                                 ItemsSource="{Binding Difficulties}"
                                 SelectedItem="{Binding SelectedDifficulty, Mode=TwoWay}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Chân trang: gợi ý + nút bắt đầu -->
                <Border Grid.Row="2" Margin="0,16,0,0" Padding="0,16,0,0"
                        BorderBrush="{StaticResource LineColor}" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                                Content="Bắt đầu học  ▶" Command="{Binding StartCommand}"/>
                        <TextBlock Text="{Binding Hint}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- =====================================================
             GIAO DIỆN GRAMMAR
             ===================================================== -->
        <DataTemplate DataType="{x:Type vm:GrammarViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Tiêu đề -->
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Border Width="52" Height="52" CornerRadius="14" Background="#FFF4D6">
                        <TextBlock Text="✏" FontSize="24"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Grammar" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryDark}"/>
                        <TextBlock Text="Chọn một chủ đề ngữ pháp, AI sẽ giải thích và ra bài tập cho bạn"
                                   FontSize="13" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Ô tìm kiếm -->
                <Grid Grid.Row="1" Margin="0,20,0,8" Width="440" HorizontalAlignment="Left">
                    <TextBox x:Name="searchBox" Style="{StaticResource InputBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="🔍  Tìm chủ đề, ví dụ: bị động, passive...">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Placeholder}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=searchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Danh sách nhóm và chủ đề -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,14,0,0"
                                                Visibility="{Binding HasVisibleTopics, Converter={StaticResource BoolToVis}}">
                                        <!-- Tên nhóm -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <TextBlock Text="{Binding Icon}" FontSize="16" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryDark}"/>
                                            <TextBlock Text="{Binding Topics.Count, StringFormat=  ·  {0} chủ đề}"
                                                       FontSize="13" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextMuted}"/>
                                        </StackPanel>

                                        <!-- Các thẻ chủ đề -->
                                        <ItemsControl ItemsSource="{Binding Topics}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource TopicCard}"
                                                            Command="{Binding OpenCommand}"
                                                            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <Border DockPanel.Dock="Right" CornerRadius="8"
                                                                        Padding="8,2" Background="#E6EEFB"
                                                                        VerticalAlignment="Top" Margin="8,0,0,0">
                                                                    <TextBlock Text="{Binding Level}" FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{StaticResource PrimaryMid}"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding Name}" FontSize="14"
                                                                           FontWeight="Bold" TextWrapping="Wrap"
                                                                           Foreground="{StaticResource PrimaryDark}"/>
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding EnglishName}" Margin="0,2,0,0"
                                                                       FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                                            <DockPanel Margin="0,14,0,0">
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding MasteryText}"
                                                                           FontSize="11" Margin="10,0,0,0"
                                                                           Foreground="{StaticResource TextMuted}"/>
                                                                <ProgressBar Style="{StaticResource ThinProgress}"
                                                                             Value="{Binding Mastery, Mode=OneWay}"
                                                                             VerticalAlignment="Center"/>
                                                            </DockPanel>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Không tìm thấy -->
                        <TextBlock Text="Không tìm thấy chủ đề phù hợp" Margin="0,40,0,0"
                                   HorizontalAlignment="Center" FontSize="14"
                                   Foreground="{StaticResource TextMuted}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasResults}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </ScrollViewer>

                <Border Grid.Row="3" Margin="0,16,0,0" Padding="0,16,0,0"
                        BorderBrush="{StaticResource LineColor}" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                                Content="Bắt đầu học  ▶" Command="{Binding StartCommand}"/>
                        <TextBlock Text="{Binding Hint}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource GeneralBorder}" Padding="16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Học với AI" Margin="8,4,0,2"
                           FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryDark}"/>
                <TextBlock DockPanel.Dock="Top" Text="Chọn kỹ năng bạn muốn luyện" Margin="8,0,0,16"
                           FontSize="12" Foreground="{StaticResource TextMuted}"/>

                <!-- Ô AI gợi ý ở đáy -->
                <Border DockPanel.Dock="Bottom" CornerRadius="14" Padding="16" Margin="0,12,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#061A45" Offset="0"/>
                            <GradientStop Color="#0B3A82" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="✨ AI gợi ý" FontSize="13" FontWeight="Bold" Foreground="#FFC857"/>
                        <TextBlock Text="{Binding AISuggestion}" Margin="0,6,0,0" FontSize="12"
                                   Foreground="White" TextWrapping="Wrap" LineHeight="18"/>
                    </StackPanel>
                </Border>

                <!-- 3 kỹ năng -->
                <StackPanel>
                    <RadioButton Style="{StaticResource SkillNavButton}" IsChecked="True"
                                 Command="{Binding ShowListeningCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="12" Background="LightPink">
                                <TextBlock Text="🎧" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Listening" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryDark}"/>
                                <TextBlock Text="Nghe theo tình huống" FontSize="11"
                                           Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource SkillNavButton}"
                                 Command="{Binding ShowReadingCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="12" Background="#E3F6EA">
                                <TextBlock Text="📖" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Reading" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryDark}"/>
                                <TextBlock Text="Đọc hiểu theo tình huống" FontSize="11"
                                           Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource SkillNavButton}"
                                 Command="{Binding ShowGrammarCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="12" Background="#FFF4D6">
                                <TextBlock Text="✏" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Grammar" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryDark}"/>
                                <TextBlock Text="Học theo chủ đề ngữ pháp" FontSize="11"
                                           Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource GeneralBorder}" Padding="28">
            <ContentControl Content="{Binding CurrentSkill}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>
        </Border>
    </Grid>
</UserControl>