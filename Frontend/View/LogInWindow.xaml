<Window x:Class="Frontend.View.LogInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Frontend.View"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        WindowStyle="None"
        Height="700" Width="1000">
    
    <Window.Resources>
        <Style x:Key="ModernInput" TargetType="Control">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">

                        <Border Background="#F5F5F5" 
                                CornerRadius="8" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="10,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextBlockInput" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#082B63"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
    </Window.Resources>

    <Border>
        <Border.Background>
            <DrawingBrush Stretch="Fill">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <!-- Lớp nền: gradient chéo -->
                        <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
                            <GeometryDrawing.Brush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#01061A" Offset="0.0" />
                                    <GradientStop Color="#061A45" Offset="0.4" />
                                    <GradientStop Color="#0B3A82" Offset="0.75" />
                                    <GradientStop Color="#082B63" Offset="1.0" />
                                </LinearGradientBrush>
                            </GeometryDrawing.Brush>
                        </GeometryDrawing>

                        <!-- Lớp sáng loang ở góc trên phải -->
                        <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
                            <GeometryDrawing.Brush>
                                <RadialGradientBrush Center="0.85,0.15" GradientOrigin="0.85,0.15"
                                             RadiusX="0.6" RadiusY="0.6">
                                    <GradientStop Color="#661E88E5" Offset="0.0" />
                                    <GradientStop Color="#001E88E5" Offset="1.0" />
                                </RadialGradientBrush>
                            </GeometryDrawing.Brush>
                        </GeometryDrawing>

                        <!-- Lớp sáng xanh ngọc nhẹ ở góc dưới trái -->
                        <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
                            <GeometryDrawing.Brush>
                                <RadialGradientBrush Center="0.1,0.9" GradientOrigin="0.1,0.9"
                                             RadiusX="0.55" RadiusY="0.55">
                                    <GradientStop Color="#4400B4D8" Offset="0.0" />
                                    <GradientStop Color="#0000B4D8" Offset="1.0" />
                                </RadialGradientBrush>
                            </GeometryDrawing.Brush>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>
        </Border.Background>

        <Border CornerRadius="20" Background="White" Width="400" MinHeight="550"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Opacity="0.2" ShadowDepth="5"/>
            </Border.Effect>

            <Grid Margin="30">
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Button_Close"/>

                <StackPanel VerticalAlignment="Center">
                    <!-- Logo/Icon -->
                    <TextBlock Text="📚" FontSize="50" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="#0B3A82"/>
                    <TextBlock x:Name="txtTitle"  FontSize="24" FontWeight="Bold" 
                               Foreground="#0B3A82" HorizontalAlignment="Center" Margin="0,0,0,30">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Đăng nhập"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRegisterMode}" Value="True">
                                        <Setter Property="Text" Value="Đăng ký"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- VÙNG NHẬP LIỆU CHUNG -->
                    
                    <!--Tên đăng nhập-->
                    <TextBlock Text="Tên đăng nhập" Style="{StaticResource TextBlockInput}"/>
                    <TextBox x:Name="txbUsername" Style="{StaticResource ModernInput}" Text="{Binding username, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock x:Name="txtErrorUserName" 
                               Foreground="Red" 
                               FontSize="11" 
                               Margin="0,-10,0,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <!-- Mặc định là ẩn ở ĐÂY, không viết ở tag bên trên -->
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExistUserName}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Text" Value="Tên đăng nhập không tồn tại!"/>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding isUsernameMissing}" Value="True">
                                        <Setter Property="Text" Value="Vui lòng nhập Tên đăng nhập!"/>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!--Mật khẩu-->
                    <TextBlock Text="Mật khẩu" Style="{StaticResource TextBlockInput}"/>
                    <PasswordBox x:Name="pwbPassword" Height="40" Margin="0,5,0,5" PasswordChanged="pwbPassword_PasswordChanged" >
                        <PasswordBox.Style>
                            <Style TargetType="PasswordBox" BasedOn="{StaticResource ModernInput}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding isPasswordWrong}" Value="True">
                                        <Setter Property="BorderBrush" Value="Red" />
                                        <Setter Property="BorderThickness" Value="1.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </PasswordBox.Style>
                    </PasswordBox>
                    <TextBlock x:Name="lblError" 
                               Foreground="Red" 
                               FontSize="11" 
                               Margin="0,0,0,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <!-- Mặc định là ẩn ở ĐÂY, không viết ở tag bên trên -->
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding isPasswordWrong}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Text" Value="Mật khẩu không chính xác!"/>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding isPasswordMissing}" Value="True">
                                        <Setter Property="Text" Value="Vui lòng nhập Mật khẩu!"/>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- VÙNG NHẬP LIỆU RIÊNG CHO ĐĂNG KÝ (ẨN MẶC ĐỊNH) -->
                    
                    <!--Xác nhận mật khẩu-->
                    <StackPanel x:Name="stkpnRegisterOnly">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding isRegisterMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Xác nhận mật khẩu" Style ="{StaticResource TextBlockInput}"/>
                        <PasswordBox x:Name="pwbConfirmPassword" Height="40" Margin="0,5,0,15" PasswordChanged="pwbConfirmPassword_PasswordChanged">
                            <PasswordBox.Style>
                                <Style TargetType="PasswordBox" BasedOn="{StaticResource ModernInput}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSimilar}" Value="False">
                                            <Setter Property="BorderBrush" Value="Red" />
                                            <Setter Property="BorderThickness" Value="1.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </PasswordBox.Style>
                        </PasswordBox>
                        <!-- TextBlock hiển thị lỗi -->
                        <TextBlock x:Name="txtPasswordErrorConfirm" 
                                  Foreground="Red" 
                                  FontSize="11" 
                                  Margin="0,0,0,10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <!-- Mặc định là ẩn ở ĐÂY, không viết ở tag bên trên -->
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding isPasswordConfirmSuccessful}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Text" Value="Mật khẩu không trùng khớp!"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding isPasswordConfirmMissing}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Text" Value="Vui lòng xác nhận mật khẩu!"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!--Email-->
                        <TextBlock Text="Email" Style="{StaticResource TextBlockInput}"/>
                        <TextBox x:Name="txbEmail" Style="{StaticResource ModernInput}"
                                 Text="{Binding email, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock x:Name="txtEmailError" 
                                  Foreground="Red" 
                                  FontSize="11" 
                                  Margin="0,0,0,10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <!-- Mặc định là ẩn ở ĐÂY, không viết ở tag bên trên -->
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding isExistEmail}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Text" Value="Email không tồn tại!"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding isEmailMissing}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Text" Value="Vui lòng nhập Email!"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Button x:Name="btnRegister" 
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#082B63"
                            FontWeight="Bold"
                            Cursor="Hand"
                            HorizontalAlignment="Right" 
                            Margin="0,0,0,15"
                            Command="{Binding ChangeUICommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="Chưa có tài khoản?"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding isRegisterMode}" Value="True">
                                        <Setter Property="Content" Value="Đăng nhập ngay"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!--Các nút thao tác-->
                    <Button x:Name="btnMain" Height="45" Command="{Binding SubmitCommand}"
                            FontSize="17" FontWeight="Bold" Margin="0,10,0,20"
                            Foreground="White" Background="#082B63"  Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="ĐĂNG NHẬP"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding isRegisterMode}" Value="True">
                                        <Setter Property="Content" Value="ĐĂNG KÝ"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>

                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
