<Window x:Class="Frontend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Frontend"
        mc:Ignorable="d"
        Height="700" Width="1200"
        Background="{StaticResource BackgroundColor}"
        FontFamily="Segoe UI"
        WindowState="Maximized" WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <!-- Bảng màu dùng chung -->
        <SolidColorBrush x:Key="PrimaryDark" Color="#082B63"/>
        <SolidColorBrush x:Key="AccentGold"  Color="#FFC857"/>

        <!-- Tab điều hướng: dùng RadioButton để tự nhớ mục đang chọn -->
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#EEF3FB"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#26FFFFFF"/>
                                <Setter Property="FontSize" Value="15"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút tài khoản -->
        <Style x:Key="AccountButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#1AFFFFFF" CornerRadius="22"
                                Padding="6,6,16,6" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LogoButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border x:Name="bd" CornerRadius="10" Padding="6" Margin="0,10">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource AccentGold}">
                                    <TextBlock Text="📚" FontSize="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="White">
                            <Run Text="Eng"/><Run Text="Learn" Foreground="{StaticResource AccentGold}"/>
                                    </TextBlock>
                                    <TextBlock Text="Learn English with AI" FontSize="11" Foreground="#9FB4D6"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== THANH ĐIỀU HƯỚNG ===== -->
        <Border Grid.Row="0" Height="72" Panel.ZIndex="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#01061A" Offset="0.0"/>
                    <GradientStop Color="#061A45" Offset="0.45"/>
                    <GradientStop Color="#0B3A82" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270"
                                  Opacity="0.3" Color="#01061A"/>
            </Border.Effect>

            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Main button -->
                <Button x:Name="btnMain" Style="{StaticResource LogoButton}"/>

                <!-- Các tab chức năng -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                    <RadioButton Style="{StaticResource NavButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🤖" Margin="0,0,8,0"/>
                            <TextBlock Text="Học với AI"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9F9;" Margin="0,2,8,0" FontSize="16"/>
                            <TextBlock Text="Thống kê kết quả"/>
                        </StackPanel>
                    </RadioButton>
                    
                    <RadioButton Style="{StaticResource NavButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗂" Margin="0,0,8,0"/>
                            <TextBlock Text="Tạo Flashcard"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEC92;" Margin="0,2,8,0" FontSize="16"/>
                            <TextBlock Text="Lịch học của tôi"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Nút tài khoản -->
                <Button Grid.Column="2" Style="{StaticResource AccountButton}" 
                        VerticalAlignment="Center" >
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="16"
                                Background="{StaticResource AccentGold}">
                            <TextBlock Text="{Binding UserInitial, FallbackValue=T}"
                                       FontWeight="Bold" Foreground="{StaticResource PrimaryDark}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Thông tin tài khoản" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Vạch nhấn màu vàng dưới thanh điều hướng -->
        <Border Grid.Row="0" Height="3" VerticalAlignment="Bottom" Panel.ZIndex="2">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00FFC857" Offset="0"/>
                    <GradientStop Color="#FFC857" Offset="0.5"/>
                    <GradientStop Color="#00FFC857" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- ===== VÙNG NỘI DUNG ===== -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Margin="24"/>
    </Grid>
</Window>
