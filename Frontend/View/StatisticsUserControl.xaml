<UserControl x:Class="Frontend.View.StatisticsUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:local="clr-namespace:Frontend.View"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1200"
             Background="#EEF3FB"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <local:DurationToTextConverter x:Key="DurationToText"/>
        <local:TestTypeToIconConverter x:Key="TypeToIcon"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Tab dạng nút phân đoạn -->
        <Style x:Key="TabButton" TargetType="RadioButton">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="9" Padding="18,8">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryDark}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chip chọn -->
        <Style x:Key="ChipItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource PrimaryDark}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="White" CornerRadius="18" Padding="14,7"
                                BorderBrush="{StaticResource LineColor}" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryMid}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryDark}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryDark}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipList" TargetType="ListBox">
            <Setter Property="ItemContainerStyle" Value="{StaticResource ChipItem}"/>
            <Setter Property="DisplayMemberPath" Value="Display"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Dòng trong Lịch sử -->
        <Style x:Key="HistoryRow" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="10" Padding="12,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SoftBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E6EEFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Tiêu đề + tab ===== -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <Border DockPanel.Dock="Right" Background="#E3EAF6" CornerRadius="12" Padding="4"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource TabButton}" GroupName="StatsTabs"
                                 Content="📊  Thống kê"
                                 Command="{Binding ShowStatsTabCommand}"
                                 IsChecked="{Binding IsStatsTab, Mode=OneWay}"/>
                    <RadioButton Style="{StaticResource TabButton}" GroupName="StatsTabs"
                                 Content="🗂  Lịch sử làm bài"
                                 Command="{Binding ShowHistoryTabCommand}"
                                 IsChecked="{Binding IsHistoryTab, Mode=OneWay}"/>
                </StackPanel>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Kết quả học tập" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryDark}"/>
                <TextBlock Text="Theo dõi tiến bộ của bạn qua từng kỹ năng" FontSize="13"
                           Foreground="{StaticResource TextMuted}"/>
            </StackPanel>
        </DockPanel>

        <!-- ===================== TAB THỐNG KÊ ===================== -->
        <Grid Grid.Row="1" Visibility="{Binding IsStatsTab, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Bộ lọc: kỹ năng bên trái, khoảng thời gian bên phải -->
            <DockPanel Grid.Row="0">
                <ListBox DockPanel.Dock="Right" Style="{StaticResource ChipList}"
                         ItemsSource="{Binding Ranges}"
                         SelectedItem="{Binding SelectedRange, Mode=TwoWay}"/>
                <ListBox Style="{StaticResource ChipList}"
                         ItemsSource="{Binding Skills}"
                         SelectedItem="{Binding SelectedSkill, Mode=TwoWay}"/>
            </DockPanel>

            <!-- 3 ô số liệu -->
            <UniformGrid Grid.Row="1" Columns="3" Margin="-8,16,-8,8">
                <Border Style="{StaticResource GeneralBorder}" Margin="8" Padding="20">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="48" Height="48" CornerRadius="14" Background="#E6EEFB">
                            <TextBlock Text="📝" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Số đề đã làm" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding TestCount}" Style="{StaticResource StatValue}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GeneralBorder}" Margin="8" Padding="20">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="48" Height="48" CornerRadius="14" Background="#E3F6EA">
                            <TextBlock Text="⏱" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Tổng thời gian" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding TotalDurationText}" Style="{StaticResource StatValue}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GeneralBorder}" Margin="8" Padding="20">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="48" Height="48" CornerRadius="14" Background="#FFF4D6">
                            <TextBlock Text="⭐" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Điểm trung bình" Style="{StaticResource StatLabel}"/>
                            <TextBlock Style="{StaticResource StatValue}">
                                <Run Text="{Binding AverageScoreText, Mode=OneWay}"/>
                                <Run Text="/10" FontSize="15" FontWeight="SemiBold"
                                     Foreground="{StaticResource TextMuted}"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Biểu đồ -->
            <Border Grid.Row="2" Style="{StaticResource GeneralBorder}" Margin="0,8,0,0" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <ListBox DockPanel.Dock="Right" Style="{StaticResource ChipList}"
                                 VerticalAlignment="Top"
                                 ItemsSource="{Binding Metrics}"
                                 SelectedItem="{Binding SelectedMetric, Mode=TwoWay}"/>
                        <StackPanel>
                            <TextBlock Text="{Binding ChartTitle}" FontSize="17" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryDark}"/>
                            <TextBlock Text="{Binding ChartSubtitle}" FontSize="12" Margin="0,2,0,0"
                                       Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,16,0,0" MinHeight="240">
                        <lvc:CartesianChart Series="{Binding Series}"
                                            XAxes="{Binding XAxes}"
                                            YAxes="{Binding YAxes}"
                                            TooltipPosition="Top"/>

                        <!-- Trạng thái trống -->
                        <Border Background="White" Visibility="Collapsed" x:Name="emptyChart">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasChartData}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📭" FontSize="34" HorizontalAlignment="Center"/>
                                <TextBlock Text="Chưa có bài làm nào trong khoảng thời gian này"
                                           Margin="0,10,0,0" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryDark}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== TAB LỊCH SỬ ===================== -->
        <Border Grid.Row="1" Style="{StaticResource GeneralBorder}" Padding="20"
                Visibility="{Binding IsHistoryTab, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Bộ lọc kỹ năng -->
                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="13"
                               Foreground="{StaticResource TextMuted}"
                               Text="{Binding HistoryCount, StringFormat={}{0} bài làm}"/>
                    <ListBox Style="{StaticResource ChipList}"
                             ItemsSource="{Binding HistoryFilters}"
                             SelectedItem="{Binding SelectedHistoryFilter, Mode=TwoWay}"/>
                </DockPanel>

                <!-- Tiêu đề cột -->
                <Grid Grid.Row="1" Margin="12,18,12,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Chủ đề"     FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Grid.Column="2" Text="Ngày làm"   FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Grid.Column="3" Text="Thời gian"  FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Grid.Column="4" Text="Điểm"       FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                </Grid>

                <!-- Danh sách: không bọc trong ScrollViewer để giữ ảo hóa -->
                <ListView Grid.Row="2"
                          ItemsSource="{Binding HistoryView}"
                          ItemContainerStyle="{StaticResource HistoryRow}"
                          Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="False"
                          VirtualizingPanel.ScrollUnit="Pixel">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Margin="12,14,0,6"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryDark}"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                                        Background="{StaticResource SoftBg}" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Type, Converter={StaticResource TypeToIcon}}" FontSize="16"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Topic}" VerticalAlignment="Center"
                                           FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource PrimaryDark}"/>
                                <TextBlock Grid.Column="2" Text="{Binding CompletedAt,StringFormat=dd/MM/yyyy HH:mm}" VerticalAlignment="Center"
                                           FontSize="13" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Grid.Column="3" Text="{Binding DurationSeconds, Converter={StaticResource DurationToText}}" VerticalAlignment="Center"
                                           FontSize="13" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Grid.Column="4" Text="{Binding Score, StringFormat={}{0:0.#}/10}" VerticalAlignment="Center"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryDark}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Trạng thái trống -->
                <TextBlock Grid.Row="2" Text="Bạn chưa làm bài nào" HorizontalAlignment="Center"
                           VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource TextMuted}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HistoryCount}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>